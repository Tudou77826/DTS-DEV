# Generate with: openssl rand -hex 32
DTS_JWT_SECRET=replace-with-a-random-secret

# Only used when the configured users are created for the first time.
DTS_BOOTSTRAP_DEFAULT_PASSWORD=123456

# ─── 认证方式（OAuth 对接） ───
# 生产环境对接统一认证：启用代理头认证，关闭本地账号密码登录
DTS_AUTH_LOCAL_ENABLED=false
DTS_OAUTH_HEADER_ENABLED=true
# 反向代理（OAuth 认证网关）注入的用户身份头名称；网关必须剥离外部伪造的同名头
DTS_OAUTH_USERNAME_HEADER=X-Auth-User
DTS_OAUTH_DISPLAY_NAME_HEADER=X-Auth-Display-Name
DTS_OAUTH_EMAIL_HEADER=X-Auth-Email
DTS_OAUTH_EMPLOYEE_NO_HEADER=X-Auth-Employee-No

# 本地开发（未接入统一认证）时放开：
# DTS_AUTH_LOCAL_ENABLED=true
# DTS_OAUTH_HEADER_ENABLED=false
